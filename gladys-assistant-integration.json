{
  "manifest_version": 1,
  "type": "device",
  "name": "NOAA Tides",
  "description": {
    "en": "Tides at the NOAA stations of the United States: next high and low tides, level, alerts.",
    "fr": "Marées aux stations NOAA des États-Unis : pleines et basses mers, hauteur d’eau, alertes.",
    "de": "Gezeiten an den NOAA-Stationen der USA: Hoch- und Niedrigwasser, Wasserstand, Warnungen.",
    "es": "Mareas en las estaciones NOAA de Estados Unidos: pleamares, bajamares, nivel y alertas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-noaa-tides:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-noaa-tides/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your tide stations",
        "fr": "Vos stations de marée",
        "de": "Deine Gezeitenstationen",
        "es": "Sus estaciones de marea"
      },
      "description": {
        "en": "Follow the tide predictions of NOAA (Tides & Currents) at the stations of the United States and its territories. \"Find stations\" below gives their ids. Save, then create the devices in the Discover tab.",
        "fr": "Suivez les prédictions de marée de la NOAA (Tides & Currents) aux stations des États-Unis et de leurs territoires. « Chercher des stations » ci-dessous donne leurs numéros. Enregistrez, puis créez les appareils dans l’onglet Découverte.",
        "de": "Verfolge die Gezeitenvorhersagen der NOAA (Tides & Currents) an den Stationen der USA und ihrer Gebiete. „Stationen suchen“ unten zeigt ihre Kennungen. Speichere und lege dann die Geräte im Tab „Entdecken“ an.",
        "es": "Siga las predicciones de marea de la NOAA (Tides & Currents) en las estaciones de Estados Unidos y sus territorios. «Buscar estaciones» le da sus identificadores. Guarde y, después, cree los dispositivos en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://tidesandcurrents.noaa.gov/tide_predictions.html",
          "label": {
            "en": "NOAA tide stations map",
            "fr": "Carte des stations NOAA",
            "de": "Karte der NOAA-Stationen",
            "es": "Mapa de las estaciones NOAA"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "required": false,
      "default": "",
      "label": {
        "en": "Stations",
        "fr": "Stations",
        "de": "Stationen",
        "es": "Estaciones"
      },
      "description": {
        "en": "Station ids or names, separated by commas (10 at most). An id is exact; a name takes the closest match.",
        "fr": "Numéros ou noms de stations, séparés par des virgules (10 au plus). Un numéro est exact ; un nom prend la station la plus proche du texte.",
        "de": "Kennungen oder Namen der Stationen, durch Kommas getrennt (höchstens 10). Eine Kennung ist eindeutig; ein Name nimmt die beste Übereinstimmung.",
        "es": "Identificadores o nombres de estaciones, separados por comas (10 como máximo). Un identificador es exacto; un nombre toma la mejor coincidencia."
      },
      "placeholder": {
        "en": "e.g. 9414290, Boston",
        "fr": "ex. 9414290, Boston",
        "de": "z. B. 9414290, Boston",
        "es": "p. ej. 9414290, Boston"
      }
    },
    {
      "key": "units",
      "type": "select",
      "required": false,
      "default": "metric",
      "label": {
        "en": "Units",
        "fr": "Unités",
        "de": "Einheiten",
        "es": "Unidades"
      },
      "description": {
        "en": "Of the heights and temperatures. After a change, click \"Update\" on the devices in the Discover tab.",
        "fr": "Des hauteurs et des températures. Après un changement, cliquez sur « Mettre à jour » sur les appareils dans l’onglet Découverte.",
        "de": "Der Höhen und Temperaturen. Klicke nach einer Änderung im Tab „Entdecken“ bei den Geräten auf „Aktualisieren“.",
        "es": "De las alturas y temperaturas. Tras un cambio, pulse «Actualizar» en los dispositivos de la pestaña Descubrir."
      },
      "options": [
        {
          "value": "metric",
          "label": {
            "en": "Metres and °C",
            "fr": "Mètres et °C",
            "de": "Meter und °C",
            "es": "Metros y °C"
          }
        },
        {
          "value": "imperial",
          "label": {
            "en": "Feet and °F",
            "fr": "Pieds et °F",
            "de": "Fuß und °F",
            "es": "Pies y °F"
          }
        }
      ]
    },
    {
      "key": "alert_levels",
      "type": "string",
      "required": false,
      "default": "",
      "label": {
        "en": "Alert levels of the high tides",
        "fr": "Seuils d’alerte des pleines mers",
        "de": "Warnpegel der Hochwasser",
        "es": "Niveles de alerta de las pleamares"
      },
      "description": {
        "en": "For the trigger \"High tide above the alert level\", above MLLW, in the units above: one level (2.1) or one per station (9414290=2.1; 8443970=3.6). Empty: the NOAA minor flood level, where the station has one.",
        "fr": "Pour le déclencheur « Pleine mer au-dessus du seuil », au-dessus de MLLW, dans les unités ci-dessus : un seuil (2,1) ou un par station (9414290=2,1 ; 8443970=3,6). Vide : le seuil de crue mineure de la NOAA, si la station en a un.",
        "de": "Für den Auslöser „Hochwasser über dem Warnpegel“, über MLLW, in den Einheiten oben: ein Pegel (2,1) oder einer pro Station (9414290=2,1; 8443970=3,6). Leer: der Pegel für leichte Überflutung der NOAA, falls die Station einen hat.",
        "es": "Para el disparador «Pleamar por encima del nivel de alerta», sobre MLLW, en las unidades de arriba: un nivel (2,1) o uno por estación (9414290=2,1; 8443970=3,6). Vacío: el nivel de inundación menor de la NOAA, si la estación lo tiene."
      },
      "placeholder": {
        "en": "e.g. 9414290=2.1",
        "fr": "ex. 9414290=2,1",
        "de": "z. B. 9414290=2,1",
        "es": "p. ej. 9414290=2,1"
      }
    },
    {
      "key": "language",
      "type": "select",
      "required": false,
      "default": "fr",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Of the device and feature names (set when the devices are created) and of the texts sent to the scenes.",
        "fr": "Des noms d’appareils et de fonctionnalités (fixés à la création des appareils) et des textes envoyés aux scènes.",
        "de": "Der Geräte- und Funktionsnamen (beim Anlegen der Geräte festgelegt) und der Texte für die Szenen.",
        "es": "De los nombres de dispositivos y funciones (fijados al crear los dispositivos) y de los textos enviados a las escenas."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "search_stations",
      "label": {
        "en": "Find stations",
        "fr": "Chercher des stations",
        "de": "Stationen suchen",
        "es": "Buscar estaciones"
      },
      "description": {
        "en": "Lists NOAA tide stations with their id, distance and kind: near your house, near a point, by name or by id.",
        "fr": "Liste les stations de marée NOAA avec leur numéro, leur distance et leur type : près de votre maison, près d’un point, par nom ou par numéro.",
        "de": "Listet NOAA-Gezeitenstationen mit Kennung, Entfernung und Art auf: nahe deinem Haus, nahe einem Punkt, nach Name oder Kennung.",
        "es": "Enumera las estaciones de marea NOAA con su identificador, distancia y tipo: cerca de su casa, cerca de un punto, por nombre o por identificador."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "query",
          "type": "string",
          "required": false,
          "label": {
            "en": "What",
            "fr": "Quoi",
            "de": "Was",
            "es": "Qué"
          },
          "description": {
            "en": "Empty: near your house. Or a name (Boston), a state with it (Sausalito CA), latitude and longitude (37.8, -122.47) or an id.",
            "fr": "Vide : près de votre maison. Ou un nom (Boston), avec l’État (Sausalito CA), une latitude et une longitude (37.8, -122.47) ou un numéro.",
            "de": "Leer: nahe deinem Haus. Oder ein Name (Boston), mit Bundesstaat (Sausalito CA), Breiten- und Längengrad (37.8, -122.47) oder eine Kennung.",
            "es": "Vacío: cerca de su casa. O un nombre (Boston), con el estado (Sausalito CA), latitud y longitud (37.8, -122.47) o un identificador."
          },
          "placeholder": {
            "en": "e.g. Boston",
            "fr": "ex. Boston",
            "de": "z. B. Boston",
            "es": "p. ej. Boston"
          }
        }
      ]
    }
  ],
