  "scene_actions": [
    {
      "key": "get_next_tide",
      "label": {
        "en": "Tide: get the next tide",
        "fr": "Marée : obtenir la prochaine marée",
        "de": "Gezeiten: nächste Gezeit abrufen",
        "es": "Marea: obtener la próxima marea"
      },
      "description": {
        "en": "Gives the next high or low tide of a station to the following actions (time, height, sentence).",
        "fr": "Donne aux actions suivantes la prochaine pleine ou basse mer d’une station (heure, hauteur, phrase).",
        "de": "Gibt den folgenden Aktionen das nächste Hoch- oder Niedrigwasser einer Station (Uhrzeit, Höhe, Satz).",
        "es": "Da a las acciones siguientes la próxima pleamar o bajamar de una estación (hora, altura, frase)."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "station",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
